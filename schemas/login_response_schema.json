{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoginResponse",
  "type": "object",
  "required": ["accessToken"],
  "properties": {
    "accessToken":  { "type": "string", "minLength": 1 },
    "refreshToken": { "type": "string" },
    "id":           { "type": "integer" },
    "username":     { "type": "string" }
  }
}
