{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserList",
  "type": "object",
  "required": ["users", "total", "skip", "limit"],
  "properties": {
    "total": { "type": "integer" },
    "skip":  { "type": "integer" },
    "limit": { "type": "integer" },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "firstName", "lastName", "email"],
        "properties": {
          "id":        { "type": "integer" },
          "firstName": { "type": "string" },
          "lastName":  { "type": "string" },
          "email":     { "type": "string" }
        }
      }
    }
  }
}
