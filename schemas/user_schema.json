{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "required": ["id", "firstName", "lastName", "email"],
  "properties": {
    "id":        { "type": "integer", "minimum": 1 },
    "firstName": { "type": "string", "minLength": 1 },
    "lastName":  { "type": "string", "minLength": 1 },
    "email":     { "type": "string" }
  }
}
